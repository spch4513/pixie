{
  "name": "pixie",
  "private": true,
  "version": "1.0.0",
  "description": "Pixie — pinch reality into pixels. A live, local-only camera filter controlled by hand gestures.",
  "type": "module",
  "scripts": {
    "setup:assets": "node scripts/setup-mediapipe.mjs",
    "predev": "node scripts/setup-mediapipe.mjs",
    "dev": "vite",
    "dev:https": "node scripts/setup-mediapipe.mjs && vite --mode https --host",
    "prebuild": "node scripts/setup-mediapipe.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:https": "vite preview --mode https --host",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "check": "tsc -b && eslint ."
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  }
}
